{
  "name": "@uxfront/testlane",
  "version": "3.0.1",
  "description": "Materialize any git ref of a configured project into an isolated, runnable local workspace.",
  "keywords": [
    "git",
    "worktree",
    "pull-request",
    "branch",
    "cli",
    "dev-server",
    "code-review",
    "agents"
  ],
  "homepage": "https://testlane.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxfront-com/testlane.git"
  },
  "type": "module",
  "bin": {
    "testlane": "./dist/bin/testlane.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "DESIGN.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm run build && node dist/bin/testlane.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "guard:packaging": "vitest run test/integration/packaging.test.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run guard:packaging && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "tinyglobby": "^0.2.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^20.11.0",
    "@uxfront/oxfmt-config": "^0.1.1",
    "@uxfront/oxlint-config": "^0.1.1",
    "@uxfront/typescript-config": "^0.2.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
