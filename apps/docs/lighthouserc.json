{
	"ci": {
		"collect": {
			"startServerCommand": "WRANGLER_SEND_METRICS=false pnpm dlx wrangler@4 dev --config ../../wrangler.jsonc --ip 127.0.0.1 --port 8787",
			"startServerReadyPattern": "Ready on",
			"startServerReadyTimeout": 120000,
			"url": [
				"http://127.0.0.1:8787/",
				"http://127.0.0.1:8787/docs/getting-started/introduction",
				"http://127.0.0.1:8787/docs/getting-started/quick-start",
				"http://127.0.0.1:8787/docs/guides/review-a-pull-request",
				"http://127.0.0.1:8787/docs/cli/workspace-verbs",
				"http://127.0.0.1:8787/docs/configuration/project-file"
			],
			"numberOfRuns": 3
		},
		"assert": {
			"assertions": {
				"categories:performance": ["warn", { "minScore": 0.95 }],
				"categories:accessibility": ["error", { "minScore": 0.95 }],
				"categories:best-practices": ["error", { "minScore": 0.95 }],
				"categories:seo": ["error", { "minScore": 1 }]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
